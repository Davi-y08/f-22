{
  "agent_id": "stealth-lens-local",
  "device": "auto",
  "status_interval_seconds": 15,
  "logging": {
    "level": "INFO",
    "json": true
  },
  "storage": {
    "events_dir": "artifacts/events",
    "snapshots_dir": "artifacts/snapshots",
    "status_path": "artifacts/status/agent-status.json"
  },
  "cloud": {
    "enabled": false,
    "api_base_url": "https://api-f22.onrender.com",
    "agent_access_key": "",
    "sync_discovered_cameras": true,
    "sync_events": true,
    "timeout_seconds": 8
  },
  "model_catalog": {
    "smoking_monitor": {
      "path": "runs/detect/train/weights/best.pt",
      "class_filters": [
        "person",
        "cigarette",
        "smoke"
      ],
      "confidence": 0.25,
      "cooldown_seconds": 8,
      "emit_events": false,
      "use_tracking": true,
      "tracker": "bytetrack.yaml",
      "input_size": 640
    }
  },
  "cameras": [
    {
      "id": "entrance",
      "name": "Entrada",
      "source": "rtsp://usuario:senha@ip:554/stream1",
      "models": [
        "smoking_monitor"
      ],
      "fps_analysis": 3,
      "enabled": true,
      "snapshot_on_event": true,
      "queue_maxsize": 2,
      "cooldown_seconds": 10,
      "backend_preference": "auto",
      "zones": [],
      "display": {
        "enabled": true,
        "window_name": "Stealth Lens Agent - RTSP Entrance",
        "show_metrics": true,
        "draw_zones": true,
        "max_width": null,
        "target_fps": 24,
        "fullscreen": false,
        "fit_mode": "contain",
        "interpolation": "auto",
        "enhance": false
      },
      "smoking_behavior": {
        "enabled": true,
        "model": "smoking_monitor",
        "person_label": "person",
        "cigarette_label": "cigarette",
        "smoke_label": "smoke",
        "event_type": "smoking",
        "max_distance_px": 80,
        "smoke_distance_multiplier": 1.35,
        "min_frames": 7,
        "min_evidence_frames": 3,
        "min_cigarette_evidence_frames": 1,
        "min_person_confidence": 0.25,
        "min_cigarette_confidence": 0.28,
        "min_smoke_confidence": 0.25,
        "min_association_score": 0.2,
        "distance_person_scale": 0.24,
        "decay_frames": 1,
        "smoke_boost_frames": 2,
        "stale_track_seconds": 5,
        "event_cooldown_seconds": 20,
        "require_person_track": true
      }
    }
  ]
}
